# Sudoku Evolved Website — environment variables

# Public site URL (used for sitemap, OG tags, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://sudokuevolved.com

# App deep-link scheme. Must match `scheme` in the Expo app.json.
NEXT_PUBLIC_APP_SCHEME=sudokuevolved

# Supabase — same project as the mobile app. Anon key only.
# Never set SUPABASE_SERVICE_ROLE_KEY on the marketing site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Store CTAs. The iOS App Store URL defaults to the live listing in code
# (see src/lib/deep-links/urls.ts); set this only to override for staging or a
# regional storefront. NEXT_PUBLIC_TESTFLIGHT_URL is no longer wired to any
# visible CTA. Android renders "Coming soon" until the Play Store URL is set.
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_TESTFLIGHT_URL=
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=
