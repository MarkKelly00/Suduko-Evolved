# Files / dirs to exclude from the EAS Build upload. Reduces upload
# size + prevents non-app code (Node scripts, raw secrets, dev docs)
# from being included in the bundle context.

# Node-only generator scripts (e.g. ElevenLabs SFX generation).
# These use `dotenv`, `node:fs/promises`, `@elevenlabs/elevenlabs-js`
# and are run locally — they have no place in the iOS bundle.
scripts/

# Editor + OS noise
.DS_Store
.vscode/
.idea/

# Source maps + dev artefacts
*.log
coverage/

# Secrets shouldn't be uploaded — EAS reads env from the build profile
.env
.env.local
.env.development
.env.production

# Local-only paths
*.local

# Native build artifacts — EAS regenerates these on its build server
# via `pod install` + `xcodebuild`. Locally we ship the Podfile +
# Podfile.lock + .xcodeproj/.xcworkspace + Swift sources (everything
# under ios/SudokuEvolved/, which is the app's own native code), but
# we DO NOT need to upload:
#   - ios/Pods/  ~ 929 MB of CocoaPods dependencies (re-installed
#                  from Podfile.lock on EAS, deterministic)
#   - ios/build/ ~ Xcode-generated DerivedData / build outputs from
#                  any local `expo run:ios` invocation
# Excluding these dropped a 450 MB upload back to ~28 MB.
ios/Pods/
ios/build/
ios/DerivedData/
# Android equivalents in case prebuild is run for android too
android/build/
android/.gradle/
android/app/build/
