# Sudoku Evolved — environment variables
# Copy to .env and fill in. .env is gitignored.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the bundle at build time.
# NEVER put service-role keys or secrets in EXPO_PUBLIC_* — they ship with the app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx

# Google Sign-In
# iOS client ID: from Google Cloud Console -> Credentials -> "iOS" OAuth client.
# Web client ID: from Google Cloud Console -> Credentials -> "Web application" OAuth client
#   (this is the one Supabase uses to verify Google id_tokens — paste it into
#   Supabase Dashboard -> Authentication -> Providers -> Google).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
